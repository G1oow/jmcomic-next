# Copy this file to secrets.properties (never commit the copy) or provide the
# values as CI/environment variables with the same names.
JM_BUILTIN_TOKEN_SECRET=
JM_APP_DATA_SECRET=

# Optional release signing values. Keep the keystore outside this repository.
# JM_RELEASE_STORE_FILE=C:/secure/jm-release.jks
# JM_RELEASE_STORE_PASSWORD=
# JM_RELEASE_KEY_ALIAS=
# JM_RELEASE_KEY_PASSWORD=

# 设为 true 时，缺少上面三项签名配置会让构建直接失败（CI 上默认开启）。
# JM_REQUIRE_RELEASE_SIGNING=true
